<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical" android:background="#07131F"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="14dp" android:background="#102B43"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="ASIAN LIVE STUDIO" android:textColor="#FFFFFF"
            android:textStyle="bold" android:textSize="18sp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/profileLabel" android:text="Asian Press"
            android:textColor="#A9D8FF" android:textSize="12sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_margin="8dp">
        <com.pedro.library.view.OpenGlView android:id="@+id/openGlView"
            android:layout_width="match_parent" android:layout_height="match_parent"
            app:aspectRatioMode="adjust" />
        <FrameLayout android:id="@+id/watermarkLayer"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clickable="false" android:focusable="false">
            <LinearLayout android:orientation="vertical" android:padding="10dp"
                android:layout_gravity="top|start" android:background="#66000000"
                android:layout_width="wrap_content" android:layout_height="wrap_content">
                <ImageView android:id="@+id/logoView" android:visibility="gone"
                    android:adjustViewBounds="true" android:scaleType="fitCenter"
                    android:layout_width="84dp" android:layout_height="54dp"/>
                <TextView android:id="@+id/watermarkName" android:text="ASIAN PRESS"
                    android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/watermarkPhone" android:text="9865323570"
                    android:textColor="#FFFFFF" android:textSize="13sp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <TextView android:id="@+id/liveBadge" android:text="● LIVE PREVIEW"
                android:textColor="#FFFFFF" android:background="#C62828"
                android:padding="7dp" android:textStyle="bold"
                android:layout_gravity="top|end" android:layout_margin="10dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/ticker" android:text="Asian Press • Photo • Video • Printing"
                android:textColor="#FFFFFF" android:textStyle="bold" android:singleLine="true"
                android:ellipsize="marquee" android:marqueeRepeatLimit="marquee_forever"
                android:padding="9dp" android:background="#CC0B3D68"
                android:layout_gravity="bottom" android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </FrameLayout>
    </FrameLayout>
    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="10dp" android:paddingEnd="10dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/statusText" android:text="Ready"
            android:textColor="#B8D5EA" android:padding="6dp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/bitrateText" android:textColor="#A9D8FF"
            android:textStyle="bold" android:padding="6dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:gravity="center"
        android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/switchCamera" android:text="Flip"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button android:id="@+id/recordButton" android:text="Record"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button android:id="@+id/liveButton" android:text="Go Live"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:gravity="center"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingBottom="10dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/profileButton" android:text="Studio Profile"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button android:id="@+id/logoButton" android:text="Watermark Editor"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button android:id="@+id/settingsButton" android:text="Quality"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
